{
  "name": "pestore-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Express and MongoDB server for the EEcho petstore example",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "build": "npm run clean && npm run build --workspace @pestore/api-lib && tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "author": "Cogi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eecho/eechojs.git"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@eecho/express": "*",
    "@pestore/api-lib": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongodb": "^6.20.0"
  }
}
